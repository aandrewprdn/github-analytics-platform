# Local development environment variables
LOCAL_INGESTIONS_PATH=ingestions/github-analytics/bronze/github/repositories

# PostgreSQL
POSTGRES_HOST=de-postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_RAW_TABLE_NAME=github_repositories

# Airflow
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW__API_AUTH__JWT_SECRET=

# MinIO
MINIO_ENDPOINT_URL=http://de-minio:9000
MINIO_BUCKET_NAME=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# dbt (optional overrides; credentials reuse POSTGRES_*)
# DBT_HOST=localhost
# DBT_SCHEMA=analytics

# GitHub API
GITHUB_API_TOKEN=
