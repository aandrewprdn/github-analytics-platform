# Local development environment variables

# PostgreSQL
POSTGRES_HOST=de-postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_RAW_TABLE_NAME=github_repositories

# Airflow
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW__API_AUTH__JWT_SECRET=

# MinIO
MINIO_ENDPOINT_URL=http://de-minio:9000
MINIO_BUCKET_NAME=
# Optional prefix for bronze objects (default shown)
# MINIO_BASE_KEY=ingestions/github-analytics/bronze/github/repositories
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# dbt (optional overrides; credentials reuse POSTGRES_*)
# DBT_HOST=localhost
# DBT_SCHEMA=analytics

# Evidence (read-only dashboard user, created by `make evidence-setup`)
EVIDENCE_DB_USER=evidence_reader
EVIDENCE_DB_PASSWORD=

# GitHub API
GITHUB_API_TOKEN=
